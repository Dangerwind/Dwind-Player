    <string name="help_header_title">Dwind Player</string>
    <string name="help_header_text">A music player for dance training that can measure the tempo of music (BPM).</string>
    <string name="help_tabs_title">Folders and playlists</string>
    <string name="help_tabs_text">Switch between device folders and playlists.</string>
    <string name="help_menu_title">Menu</string>
    <string name="help_menu_text">Settings: BPM measurement, voice cues, theme, style, export/import and help.</string>
    <string name="help_sort_name_title">Sort by name</string>
    <string name="help_sort_name_text">\"Name\" — sort by file name.</string>
    <string name="help_sort_title_title">Sort by title</string>
    <string name="help_sort_title_text">\"Title\" — sort by track title.</string>
    <string name="help_sort_bpm_title">Sort by BPM</string>
    <string name="help_sort_bpm_text">\"BPM\" — sort by tempo.</string>
    <string name="help_playlist_item_title">Playlists</string>
    <string name="help_playlist_item_text">Tap a playlist to open it; the icons on the right rename and delete.</string>
    <string name="help_create_playlist_title">Create playlist</string>
    <string name="help_create_playlist_text">Collect tracks into playlists for your mood.</string>
    <string name="help_add_tracks_title">Add tracks</string>
    <string name="help_add_tracks_text">Add tracks from your library to this playlist.</string>
    <string name="help_list_title">List</string>
    <string name="help_list_text_tracks">Tap a row to play. The color of the BPM number shows the detection confidence.</string>
    <string name="help_list_text_folders">Tap a folder to open it, tap a track to play.</string>
    <string name="help_bpm_text_title">BPM number</string>
    <string name="help_bpm_text_text">Tap the BPM number to enter the tempo manually and choose a style.</string>
    <string name="help_bpm_detect_title">Detect BPM</string>
    <string name="help_bpm_detect_text">Measures the BPM of this track only.</string>
    <string name="help_bpm_button_title">BPM analysis</string>
    <string name="help_bpm_button_text">Measures the BPM of all tracks in the current folder.</string>
    <string name="help_playlist_bpm_text">Measures the BPM of all tracks in the playlist.</string>
    <string name="help_bpm_filter_title">BPM filter</string>
    <string name="help_bpm_filter_text">Turn it on to play only tracks whose BPM is within the chosen range. The rest are greyed out.</string>
    <string name="help_voice_cues_chip_title">Voice cues</string>
    <string name="help_voice_cues_chip_text">Tap to turn voice cues on/off. Long press opens settings: intervals, phrase lists, separate Russian and English voices, and music ducking volume.</string>
    <string name="help_player_voice_cues_title">Voice cues button</string>
    <string name="help_player_voice_cues_text">Quickly toggles voice cues right from the mini player without leaving playback.</string>
    <string name="help_ab_title">Section A–B</string>
    <string name="help_ab_text">Play a track and tap \"A–B\" in the mini player — the section panel opens under the time bar. Tap A at the start of the fragment and B at its end: the A and B badges appear on the time bar and the chosen section is highlighted. \"▶A\" plays from the start of the fragment. \"⟲\" loops it: playback goes from A to B, pauses for one second and starts again from A. \"✕\" clears the markers, and a long press on A or B jumps to that marker. Markers belong to the current track and reset when you switch tracks.</string>
    <string name="help_player_title">Mini player</string>
    <string name="help_player_text">Playback control, track shuffle and the A–B section.</string>
    <string name="help_add_to_playlist_title">To playlist</string>
    <string name="help_add_to_playlist_text">The \"+\" button adds the current track to a playlist.</string>
    <string name="help_more_title">What else it can do</string>
    <string name="help_recap">In short: BPM measurement (whole folder, single track and manual tapping), manual tempo and style entry, playlists, sorting, BPM and theme settings, playback BPM filter, voice cues (cue button in the list and mini player, separate Russian and English voice selection, fixed and random intervals), mini player with shuffle, A–B section looping, database export and import.</string>
    <string name="help_recap_missing_prefix">\n\nNot everything is visible on this screen. To try it — </string>
    <string name="help_missing_bpm">open a folder or playlist with tracks — that\'s where BPM works</string>
    <string name="help_missing_sort">in a folder with tracks there is sorting by file name, track title and BPM</string>
    <string name="help_missing_voice_cues">in a folder or playlist with tracks you will find the \"Cues\" button (long press for settings)</string>
    <string name="help_missing_playlists">on the \"Playlists\" tab you can create playlists and add tracks</string>
    <string name="help_missing_player">play a track — a mini player will appear, with the \"A–B\" button for looping a section</string>
</resources>
