<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема-обёртка: настоящие цвета задаёт Compose (DwindTheme).
         Здесь важен только windowBackground, чтобы не мигало белым при старте. -->
    <style name="Theme.Dwind" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
